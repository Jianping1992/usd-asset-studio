{
  "name": "usd-asset-studio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "description": "Embodied intelligence asset management and Web USD visualization platform",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite --host 127.0.0.1\" \"node --watch server/index.mjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.mjs",
    "test": "node tests/api.test.mjs",
    "verify": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@needle-tools/usd": "1.1.2",
    "echarts": "6.1.0",
    "fastify": "5.12.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "three": "0.185.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "8.2.2",
    "typescript": "5.7.3",
    "vite": "8.2.2"
  }
}
