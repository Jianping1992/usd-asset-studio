#usda 1.0
(
    defaultPrim = "RgbdSensorRig"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "RgbdSensorRig" (
    kind = "component"
)
{
    custom string semanticClass = "rgbd_camera"
    custom string simulationSource = "ROS 2 sensor rig"

    def Cube "TripodBase"
    {
        color3f[] primvars:displayColor = [(0.12, 0.15, 0.2)]
        double size = 1
        float3 xformOp:scale = (0.72, 0.1, 0.52)
        double3 xformOp:translate = (0, 0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "Mast"
    {
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.2, 0.25, 0.32)]
        double height = 1.15
        double radius = 0.06
        double3 xformOp:translate = (0, 0.65, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "CameraHousing"
    {
        color3f[] primvars:displayColor = [(0.08, 0.31, 0.49)]
        double size = 1
        float3 xformOp:scale = (0.7, 0.24, 0.22)
        double3 xformOp:translate = (0, 1.28, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "RgbLens"
    {
        uniform token axis = "Z"
        color3f[] primvars:displayColor = [(0.02, 0.03, 0.05)]
        double height = 0.13
        double radius = 0.09
        double3 xformOp:translate = (-0.2, 1.29, 0.16)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "DepthLens"
    {
        uniform token axis = "Z"
        color3f[] primvars:displayColor = [(0.03, 0.8, 0.73)]
        double height = 0.13
        double radius = 0.09
        double3 xformOp:translate = (0.2, 1.29, 0.16)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "StatusLight"
    {
        color3f[] primvars:displayColor = [(0.13, 0.92, 0.54)]
        double radius = 0.035
        double3 xformOp:translate = (0, 1.39, 0.19)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
